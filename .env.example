# Aurora Ledger (FragLedger) - example environment. Copy to .env and fill in.
# Placeholders only. Never commit real secrets.

# Server
LEDGER_PORT=8091
# SQLite database file. Defaults to server/data/ledger.db when unset.
LEDGER_DB=server/data/ledger.db
# Runtime mode: "production" (default, demo affordances hidden) or "demo".
LEDGER_MODE=production

# Optional Google sign-in (real OAuth 2.0 auth-code + PKCE). Leave blank to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to http://localhost:$LEDGER_PORT/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Optional comma-separated allowlist of email domains.
GOOGLE_ALLOWED_DOMAINS=
